{
  // Cloudflare Workers deploy of the Next.js app through @opennextjs/cloudflare
  // (2026-11-03). Production stays on Amplify; this worker is the Cloudflare
  // build of the same repo. Workers Builds CI runs:
  //   build:  npx opennextjs-cloudflare build
  //   deploy: npx opennextjs-cloudflare deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nsrgpt",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // next-themes serialises its pre-paint function into the HTML with toString; wrangler's keep_names wraps it in
  // __name() calls that don't exist in the browser, so the theme script threw on every page (2026-11-05).
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Secrets set by hand, once (wrangler secret put; they survive every deploy):
  //   AWS_BEARER_TOKEN_BEDROCK — the nysgpt-chat-worker IAM user's Bedrock API key
  //   NSR_ATHENA_KEY_ID        — access key of nsrgpt-chat-worker (New account, policy nsr-athena-read):
  //   NSR_ATHENA_SECRET          the chat's NSR tools query nsr-lake through Athena (us-east-2)
  //   NSR_DATABASE_URL         — unused since 2026-11-04 (the NSR corpus left Neon for the lake)
  // NYSGPT_CHAT_OPEN is gone (2026-11-07): the chat requires a signed-in reader. Set it to "1"
  // in "vars" to answer without a session again.
  // NEXT_PUBLIC_DATA_BASE: the chart data's CloudFront distribution (EDQ9A6XJBYEH5, New account), read by
  // lib/data-url.ts. Next.js writes NEXT_PUBLIC_ values into the browser code at build time, so the same value
  // must also be a Workers Builds build variable; "vars" alone reaches only the running worker.
  "vars": {
    "NEXT_PUBLIC_DATA_BASE": "https://dcl3kyt3ynmb2.cloudfront.net"
  },
  "observability": {
    "enabled": true
  }
}
